# Copy to .env if you want overrides (Compose still reads .env when present).
#
# Password: omit VALKEY_PASSWORD, leave it empty, or do not create .env at all
# to run without requirepass/masterauth.
# VALKEY_PASSWORD=
# VALKEY_USERNAME=default
#
# Broken cluster on disk ("hash slot is not served", etc.): run ./create-cluster.
# Compose sets cluster-require-full-coverage no for homelab only.

VALKEY_CLUSTER_DNS=127.0.0.1
VALKEY_CLUSTER_SEED_PORT=7000

# MOVED redirects use host.docker.internal:7000-7005. On macOS run ./setup-host-macos once
# (adds 127.0.0.1 host.docker.internal to /etc/hosts).
VALKEY_CLUSTER_ANNOUNCE_HOST=host.docker.internal
